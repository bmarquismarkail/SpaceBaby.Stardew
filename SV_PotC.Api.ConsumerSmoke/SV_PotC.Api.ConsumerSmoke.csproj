<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StardewModdingApiPath Condition="'$(StardewModdingApiPath)' == '' and '$(STARDEW_MODDING_API_DLL)' != ''">$(STARDEW_MODDING_API_DLL)</StardewModdingApiPath>
    <StardewModdingApiPath Condition="'$(StardewModdingApiPath)' == '' and '$(STARDEW_VALLEY_PATH)' != ''">$(STARDEW_VALLEY_PATH)/StardewModdingAPI.dll</StardewModdingApiPath>
  </PropertyGroup>

  <Target Name="RequireStardewModdingApiPath" BeforeTargets="ResolveReferences" Condition="'$(StardewModdingApiPath)' == ''">
    <Error Text="Set the 'StardewModdingApiPath' MSBuild property or the STARDEW_MODDING_API_DLL / STARDEW_VALLEY_PATH environment variable so the consumer smoke project can compile its ModRegistry.GetApi call." />
  </Target>

  <ItemGroup>
    <!-- Match the documented consumer setup: compile against PotC without copying its DLL. -->
    <ProjectReference Include="../SV_PotC/PartOfTheCommunity.csproj" Private="false" />
    <Reference Include="StardewModdingAPI">
      <HintPath>$(StardewModdingApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
